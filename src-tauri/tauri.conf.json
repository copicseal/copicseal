{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copicseal",
  "version": "0.4.2",
  "identifier": "com.copicseal.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Copicseal",
        "width": 900,
        "height": 670,
        "minWidth": 700,
        "minHeight": 500,
        "decorations": true,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": false,
        "hiddenTitle": false,
        "acceptFirstMouse": true,
        "titleBarStyle": "Overlay",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost blob: https: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' asset: http://asset.localhost data: https://fonts.gstatic.com; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBN0JGMTU3RENGMEY1OUMKUldTYzlmRGNWL0Y3MmhENngzeXZ4SWNtbG05d01ZVEhZTWMvM0pXRTg4N3VZVEhiQkJiMDFmRzgK",
      "endpoints": [
        "https://github.com/copicseal/copicseal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
