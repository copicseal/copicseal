{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@copicseal/template-sdk": ["./sdk/index.d.ts"],
      "@copicseal/template-sdk/jsx-runtime": ["./sdk/jsx-runtime.d.ts"],
      "@copicseal/template-sdk/host-validate": ["./sdk/host-validate.d.mts"],
      "@/*": ["../../src/*"]
    }
  },
  "include": [
    "assets.d.ts",
    "templates/**/*.ts",
    "templates/**/*.tsx",
    "preview/**/*.ts",
    "preview/**/*.tsx",
    "preview/**/*.mts",
    "scripts/**/*.ts"
  ]
}
